<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The HTTP face of the Booking service. A plain ASP.NET Core app with no Aspire package of any kind,
    configured through ConnectionStrings__bookingdb like any other deployment would configure it.
  -->

  <PropertyGroup>
    <UserSecretsId>qubicacinema-bookings</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Http.HttpResults" />
    <Using Include="Microsoft.AspNetCore.Mvc" />
  </ItemGroup>

  <ItemGroup>
    <!-- Design-time only: this is the startup project the EF tooling runs, as in Catalog. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../BuildingBlocks/BuildingBlocks.Api/BuildingBlocks.Api.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/BuildingBlocks.EventBus.RabbitMQ/BuildingBlocks.EventBus.RabbitMQ.csproj" />
    <ProjectReference Include="../../../ServiceDefaults/ServiceDefaults.csproj" />
    <ProjectReference Include="../Bookings.Application/Bookings.Application.csproj" />
    <ProjectReference Include="../Bookings.Infrastructure/Bookings.Infrastructure.csproj" />
  </ItemGroup>

</Project>
