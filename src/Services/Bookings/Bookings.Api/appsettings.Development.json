{
  // Used when the service or the EF tooling runs outside the AppHost. Under the AppHost the environment
  // variable ConnectionStrings__bookingdb overrides it. The password is the fixed local development value
  // declared in src/AppHost/appsettings.json.
  "ConnectionStrings": {
    "bookingdb": "Server=localhost,1433;Database=bookingdb;User Id=sa;Password=Cinema!Local1;TrustServerCertificate=True",
    // RabbitMQ's own default account on its default port. Under the AppHost the environment variable
    // ConnectionStrings__rabbitmq overrides it with the generated credentials.
    "rabbitmq": "amqp://guest:guest@localhost:5672"
  },
  // The local development token settings, the same in every process. The validator refuses the key outside
  // Development. Under the AppHost the Jwt__* environment variables override all three.
  "Jwt": {
    "Issuer": "https://qubicacinema.local/identity",
    "Audience": "qubicacinema-api",
    "SigningKey": "qubica-cinema-local-development-signing-key-32b+"
  }
}
