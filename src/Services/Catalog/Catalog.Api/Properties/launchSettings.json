{
  // Used when this service is started on its own, with the connection string supplied by hand. Under the
  // AppHost none of this applies: the orchestrator assigns the ports and passes them in the environment.
  "profiles": {
    "http": {
      "commandName": "Project",
      "launchBrowser": false,
      "applicationUrl": "http://localhost:5101",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  }
}
