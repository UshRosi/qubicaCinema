<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The HTTP face of the Identity service: registration, login and the token it issues. A plain ASP.NET Core
    app with no Aspire package, configured through ordinary keys (ConnectionStrings__identitydb, Jwt__*).
  -->

  <PropertyGroup>
    <UserSecretsId>qubicacinema-identity</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Http.HttpResults" />
  </ItemGroup>

  <ItemGroup>
    <!-- Design-time only, and here because this is the startup project the EF tooling runs. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../BuildingBlocks/BuildingBlocks.Api/BuildingBlocks.Api.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/BuildingBlocks.Authentication/BuildingBlocks.Authentication.csproj" />
    <ProjectReference Include="../../../ServiceDefaults/ServiceDefaults.csproj" />
    <ProjectReference Include="../Identity.Persistence/Identity.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The token service and the handlers are internal; the unit tests reach them directly. -->
    <InternalsVisibleTo Include="QubicaCinema.Identity.UnitTests" />
  </ItemGroup>

</Project>
