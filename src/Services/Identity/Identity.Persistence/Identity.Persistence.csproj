<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Identity model and its database: the user and role types, the DbContext, the seed and the
    registration of ASP.NET Core Identity's stores.

    Identity is two projects where Catalog and Booking are four, on purpose. ASP.NET Core Identity is the
    model here, so a Domain and an Application layer would only wrap UserManager in interfaces of our own.
    It is split in two, and not one, because the migration service must be able to create this schema and seed
    the administrator without referencing a web application. Everything that needs HTTP is in Identity.Api.
  -->

  <ItemGroup>
    <ProjectReference Include="../../../BuildingBlocks/BuildingBlocks.Persistence/BuildingBlocks.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
  </ItemGroup>

</Project>
