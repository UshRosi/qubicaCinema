<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!--
    Applies every database schema once, then exits. Services wait for it to complete, so none of them ever
    starts against a half-built schema.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>qubicacinema-migrations</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- The worker SDK includes appsettings.json but does not copy it, unlike the web SDK. -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../BuildingBlocks/BuildingBlocks.Persistence/BuildingBlocks.Persistence.csproj" />
    <!--
      One reference per service whose schema this process owns. It reaches Infrastructure only: the
      initializer is resolved through IDatabaseInitializer, so this project never names a Catalog type.
    -->
    <ProjectReference Include="../Services/Bookings/Bookings.Infrastructure/Bookings.Infrastructure.csproj" />
    <ProjectReference Include="../Services/Catalog/Catalog.Infrastructure/Catalog.Infrastructure.csproj" />
    <ProjectReference Include="../Services/Identity/Identity.Persistence/Identity.Persistence.csproj" />
    <ProjectReference Include="../ServiceDefaults/ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
