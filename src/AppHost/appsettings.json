{
  // Local development settings. Nothing here is a real secret: the AppHost is never deployed, and every
  // consumer is handed these values through its environment. They are layered, so a developer can override
  // any of them with user secrets or an environment variable without editing a tracked file.
  "Parameters": {
    // Fixed rather than generated on purpose. A generated password lives in user secrets, so clearing those
    // while a SQL Server data volume survives leaves the container unable to start: the password no longer
    // matches the persisted master database.
    "sql-password": "Cinema!Local1",
    // One key for the whole solution. Long enough for HMAC-SHA256, which rejects keys shorter than 256 bits.
    "jwt-signing-key": "qubica-cinema-local-development-signing-key-32b+"
  },
  "Cinema": {
    // Every run starts from the same empty databases and the same seed, so a failure is reproducible.
    "UseVolumes": false,
    "PersistentContainers": false,
    "SeedData": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  }
}
