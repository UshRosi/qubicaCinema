<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared telemetry and health-check plumbing for every process in the solution.
    It holds no Aspire package and nothing domain-shaped: the AppHost is the only project that knows
    Aspire exists, and reusable domain types live in BuildingBlocks.
  -->

  <PropertyGroup>
    <IsAspireSharedProject>true</IsAspireSharedProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Needed for IEndpointRouteBuilder and the health-check endpoints, without turning this into a web app. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
  </ItemGroup>

</Project>
