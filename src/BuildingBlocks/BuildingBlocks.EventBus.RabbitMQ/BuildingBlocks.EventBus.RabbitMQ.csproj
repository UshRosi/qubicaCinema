<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The RabbitMQ implementation of the event bus, written directly on the official client: a connection
    provider, a publisher, a consumer and their topology. No messaging framework sits on top of it, so every
    delivery guarantee is visible in this project. Only a service's composition root references it.
  -->

  <ItemGroup>
    <!-- Hosting, options, logging and health checks, without making this library a web app. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../BuildingBlocks.Domain/BuildingBlocks.Domain.csproj" />
    <ProjectReference Include="../BuildingBlocks.EventBus/BuildingBlocks.EventBus.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Api" />
    <PackageReference Include="RabbitMQ.Client" />
  </ItemGroup>

</Project>
