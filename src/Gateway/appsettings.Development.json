{
  // Used when the gateway is started on its own, in front of services started by hand on the ports of their
  // launch profiles. Under the AppHost the environment variables
  // ReverseProxy__Clusters__catalog__Destinations__primary__Address (and the booking and identity ones)
  // override these. The Jwt section below is the local development one; under the AppHost the environment wins.
  "ReverseProxy": {
    "Clusters": {
      "catalog": { "Destinations": { "primary": { "Address": "http://localhost:5101/" } } },
      "booking": { "Destinations": { "primary": { "Address": "http://localhost:5102/" } } },
      "identity": { "Destinations": { "primary": { "Address": "http://localhost:5103/" } } }
    }
  },
  "Jwt": {
    "Issuer": "https://qubicacinema.local/identity",
    "Audience": "qubicacinema-api",
    "SigningKey": "qubica-cinema-local-development-signing-key-32b+"
  }
}
