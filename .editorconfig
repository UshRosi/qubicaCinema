# QubicaCinema code style.
# Curated on purpose: every rule below is a decision, not a dump of defaults. Rules that are only noise in
# an application (as opposed to a published library) are turned off with the reason written next to them.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,targets,slnx,config,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
max_line_length = 120

# EF Core writes the files under Migrations, in its own style: block namespaces, a using it does not always
# need, no documentation comments. Reformatting them by hand would be undone the next time the tooling
# regenerates the snapshot, and with warnings-as-errors an unformatted one fails the build. Marking the
# folder as generated exempts it from the style rules while leaving the correctness analyzers in place.
[**/Migrations/*.cs]
generated_code = true

[*.cs]

#### Language conventions ####

# File-scoped namespaces: one less level of indentation in every file. An error, so it is never debated.
csharp_style_namespace_declarations = file_scoped:error

# var only where the right-hand side already names the type. Failing the build on the "elsewhere" case
# would force an explicit type on every fluent builder call, where the type name is long, generic and less
# readable than the chain itself, so that one is a suggestion.
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = false:suggestion

# Braces always: a one-line if without braces is how a second statement silently escapes the condition.
csharp_prefer_braces = true:warning

csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_properties = true:silent
csharp_style_expression_bodied_constructors = false:silent

csharp_style_prefer_primary_constructors = false:silent
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_style_prefer_range_operator = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion

dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:silent

# Usings outside the namespace, sorted with System first.
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_space_after_keywords_in_control_flow_statements = true

#### Naming ####

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.i_prefixed.capitalization = pascal_case
dotnet_naming_style.i_prefixed.required_prefix = I

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_rule.interfaces_are_i_prefixed.symbols = interfaces
dotnet_naming_rule.interfaces_are_i_prefixed.style = i_prefixed
dotnet_naming_rule.interfaces_are_i_prefixed.severity = warning

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_rule.private_fields_are_underscore_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_are_underscore_camel_case.style = underscore_camel_case
dotnet_naming_rule.private_fields_are_underscore_camel_case.severity = warning

dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_rule.constants_are_pascal_case.symbols = constants
dotnet_naming_rule.constants_are_pascal_case.style = pascal_case
dotnet_naming_rule.constants_are_pascal_case.severity = warning

dotnet_naming_symbols.public_members.applicable_kinds = property,method,event,namespace,class,struct,enum,delegate
dotnet_naming_symbols.public_members.applicable_accessibilities = public,internal,protected
dotnet_naming_rule.public_members_are_pascal_case.symbols = public_members
dotnet_naming_rule.public_members_are_pascal_case.style = pascal_case
dotnet_naming_rule.public_members_are_pascal_case.severity = warning

dotnet_naming_symbols.parameters_and_locals.applicable_kinds = parameter,local
dotnet_naming_rule.parameters_and_locals_are_camel_case.symbols = parameters_and_locals
dotnet_naming_rule.parameters_and_locals_are_camel_case.style = camel_case
dotnet_naming_rule.parameters_and_locals_are_camel_case.severity = warning

#### Analyzer severities ####

# Dead code. IDE0005 runs at build time because EnforceCodeStyleInBuild is on, so with warnings-as-errors a
# stray using fails the build. That is intended — and it is the usual cause of "builds in the IDE, fails in CI".
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning

# Correctness rules worth failing the build for.
dotnet_diagnostic.CA2016.severity = warning   # forward CancellationToken
dotnet_diagnostic.CA1849.severity = warning   # no synchronous blocking inside async methods
dotnet_diagnostic.CA1002.severity = warning   # do not expose List<T>
dotnet_diagnostic.CA1819.severity = warning   # properties should not return arrays

# Off, with the reason.
dotnet_diagnostic.CA2007.severity = none      # ConfigureAwait: no synchronization context in ASP.NET Core
dotnet_diagnostic.CA1062.severity = none      # nullable reference types already express the contract
dotnet_diagnostic.CA1848.severity = none      # LoggerMessage source generators: not worth it at this scale
dotnet_diagnostic.CA1873.severity = none      # same reason: guarding every log call with IsEnabled is noise
dotnet_diagnostic.CA1303.severity = none      # no localisation; user-facing text is English by requirement
