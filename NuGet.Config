<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    <clear /> is deliberate: a reviewer may have a corporate feed configured at user level, and
    clearing inherited sources guarantees that restore resolves the same packages on every machine.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
