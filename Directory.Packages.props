<Project>

  <!--
    Central package management. Versions are grouped behind variables so that packages released together
    move together. Packages are added chapter by chapter with `dotnet add package`, which writes the entry
    here, rather than all at once up front.

    Note: the Aspire AppHost MSBuild SDK version cannot come from here — SDK resolution happens before
    property evaluation — so it is pinned in global.json and must be kept in sync with $(AspireVersion).
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AspireVersion>13.5.4</AspireVersion>
    <MicrosoftVersion>10.0.12</MicrosoftVersion>
    <OpenTelemetryVersion>1.18.0</OpenTelemetryVersion>
    <!-- dotnet/extensions ships on its own cadence; the packages from that repo really are on 10.10.x. -->
    <ExtensionsVersion>10.10.0</ExtensionsVersion>
  </PropertyGroup>

  <ItemGroup Label="Persistence">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="$(MicrosoftVersion)" />
  </ItemGroup>

  <ItemGroup Label="Api">
    <!-- Apache-2.0, verified in the 12.1.1 nuspec; a different maintainer from MediatR and AutoMapper. -->
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup Label="Authentication">
    <!-- MIT, part of ASP.NET Core. Validates the bearer token in the services and in the gateway. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(MicrosoftVersion)" />
    <!-- MIT, part of ASP.NET Core. Only the Identity persistence project references it. -->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="$(MicrosoftVersion)" />
  </ItemGroup>

  <ItemGroup Label="Gateway">
    <!--
      MIT, verified in the 2.3.0 nuspec. Targets net8.0 and runs unchanged on net10.0. Deliberately not
      paired with Microsoft.Extensions.ServiceDiscovery.Yarp: YARP builds its own HttpMessageInvoker per
      cluster, so service discovery would be dead code that looks like protection.
    -->
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup Label="Messaging">
    <!-- Apache-2.0 OR MPL-2.0, verified in the 7.2.1 nuspec. The official client; no framework on top of it. -->
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.1" />
  </ItemGroup>

  <ItemGroup Label="Hosting">
    <!-- Abstractions only: an Application project registers its use cases without referencing a container. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="$(MicrosoftVersion)" />
    <!-- Where ValidateDataAnnotations lives, for the projects that are not on the ASP.NET Core framework. -->
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="$(MicrosoftVersion)" />
  </ItemGroup>

  <ItemGroup Label="Aspire (AppHost only)">
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="$(AspireVersion)" />
  </ItemGroup>

  <ItemGroup Label="Observability">
    <PackageVersion Include="OpenTelemetry.Api" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="$(OpenTelemetryVersion)" />
    <!-- Only ever shipped as a prerelease; see docs/plan/DECISIONS.md. -->
    <PackageVersion Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.18.0-beta.1" />
  </ItemGroup>

  <!--
    No Microsoft.NET.Test.Sdk and no VSTest adapter: xunit.v3 brings Microsoft.Testing.Platform, which is
    the only runner the .NET 10 SDK supports for it. The runner is selected in dotnet.config.
  -->
  <ItemGroup Label="Tests">
    <!-- MIT, part of ASP.NET Core: hosts the gateway in memory so its routing can be tested without a container. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(MicrosoftVersion)" />
    <!-- MIT, part of ASP.NET Core: an in-memory server for testing the authentication pipeline end to end. -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="$(ExtensionsVersion)" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

</Project>
